{
  "name": "Pharma Leads Daily Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "expression": "7"
            }
          ]
        }
      },
      "id": "cron-001",
      "name": "Daily at 7AM",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5000/run-pipeline",
        "options": {},
        "sendBody": false
      },
      "id": "http-run-001",
      "name": "Run Pipeline API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://localhost:5000/get-report-path",
        "options": {}
      },
      "id": "http-get-001",
      "name": "Get Report Path",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-exists",
              "leftValue": "={{ $json.exists }}",
              "rightValue": "true",
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "if-001",
      "name": "Report Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "filePath": "={{ $json.report_path }}"
      },
      "id": "read-001",
      "name": "Read Excel File",
      "type": "n8n-nodes-base.readBinaryFiles",
      "typeVersion": 1,
      "position": [
        1050,
        200
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "to": "your-email@gmail.com",
        "subject": "Daily Pharma Leads Report - {{$now.format('YYYY-MM-DD')}}",
        "text": "Hello,\n\nYour daily pharmaceutical lead discovery report is ready.\n\nGenerated: {{$now.format('YYYY-MM-DD HH:mm:ss')}}\n\nBest regards,\nPharma Leads Pipeline",
        "html": "<html><body><h2>Daily Pharma Leads Report</h2><p>Your report is attached.</p><p><strong>Generated:</strong> {{$now.format('YYYY-MM-DD HH:mm:ss')}}</p></body></html>",
        "attachments": "={{ $binary.data }}",
        "options": {}
      },
      "id": "gmail-001",
      "name": "Send Gmail Report",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        1250,
        200
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail-creds",
          "name": "Gmail OAuth2"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "to": "your-email@gmail.com",
        "subject": "Pharma Pipeline Alert - {{$now.format('YYYY-MM-DD')}}",
        "text": "Hello,\n\nThe daily pharma lead pipeline ran but no report was generated.\n\nPlease check the pipeline logs.\n\nBest regards,\nPharma Leads Pipeline",
        "options": {}
      },
      "id": "alert-001",
      "name": "Send Alert Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        1050,
        400
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail-creds",
          "name": "Gmail OAuth2"
        }
      }
    }
  ],
  "connections": {
    "Daily at 7AM": {
      "main": [
        [
          {
            "node": "Run Pipeline API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Pipeline API": {
      "main": [
        [
          {
            "node": "Get Report Path",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Report Path": {
      "main": [
        [
          {
            "node": "Report Exists?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Report Exists?": {
      "main": [
        [
          {
            "node": "Read Excel File",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Alert Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Excel File": {
      "main": [
        [
          {
            "node": "Send Gmail Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "saveExecutionProgress": true,
    "saveManualExecutions": true
  },
  "staticData": null,
  "tags": [
    {
      "id": "tag-pharma",
      "name": "pharma-leads"
    },
    {
      "id": "tag-daily",
      "name": "daily-automation"
    }
  ]
}